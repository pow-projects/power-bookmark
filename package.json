{
  "name": "powerbookmark",
  "version": "0.2.0",
  "description": "A bookmark extension for Chrome and Firefox that handles organizing, summarizing, offline archiving, and cloud sync of your bookmarks. Features AI categorization with folder suggestions and summaries, a dashboard with collection stats and dead-link detection, single-file offline archives (ad/tracking scripts stripped, gzipped), and two-way cloud sync across Google Drive, OneDrive, Dropbox, and WebDAV with AES-256 encrypted credentials.",
  "author": "0deep <github.com/0deep>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/google": "^4.0.63",
    "@ai-sdk/openai": "^4.0.57",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@wxt-dev/i18n": "^0.2.7",
    "ai": "^7.0.91",
    "chart.js": "^4.5.1",
    "dexie": "^4.4.5",
    "pretendard": "^1.3.9",
    "turndown": "^7.2.4",
    "webdav": "^5.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/chrome": "^0.2.9",
    "@types/mozilla__readability": "^0.4.2",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^5.0.0",
    "@wxt-dev/module-svelte": "^2.0.5",
    "jsdom": "^30.0.1",
    "svelte": "^5.57.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  }
}
