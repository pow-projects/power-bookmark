# ===================================================
# Runner & Debugger Settings (Node.js Process)
# ===================================================
# Custom path to Chrome/Chromium binary (optional, auto-detected if empty)
CHROMIUM_BIN=

# Chrome remote debugging port for DevTools / MCP (default: 9222)
CHROMIUM_REMOTE_DEBUGGING_PORT=9222

# Automatically open browser on `npm run dev` (default: true)
WXT_RUNNER_OPEN=true

# ===================================================
# Dev Seed Settings (Extension Runtime - WXT_ Prefix)
# Populated on `npm run dev` when settings are empty.
# ===================================================
# WebDAV Development Seed
WXT_DEV_WEBDAV_URL=http://localhost:8085/
WXT_DEV_WEBDAV_USERNAME=admin
WXT_DEV_WEBDAV_PASSWORD=password123

# AI / Local LLM Development Seed (custom, ollama, openai, gemini, anthropic, etc.)
WXT_DEV_AI_PROVIDER=custom
WXT_DEV_AI_ENDPOINT=http://localhost:8080/v1
WXT_DEV_AI_MODEL=
WXT_DEV_AI_API_KEY=
